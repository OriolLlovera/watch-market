# Contacto real: los sitios lo ven en el User-Agent
SCRAPER_UA="WatchMarketBot/0.1 (+tu@email.com)"
SCRAPER_DELAY_MS=1000        # pausa entre peticiones al mismo host (cortesía)
LISTINGS_TTL_MIN=15          # cada cuánto se refresca cada fuente (en segundo plano)
THREAD_TTL_HOURS=48          # cuánto se recuerda el contenido de un hilo de foro
# Reddit (API oficial): https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# eBay (Browse API oficial): https://developer.ebay.com
EBAY_APP_ID=
EBAY_CERT_ID=
# EBAY_MARKETPLACES=EBAY_ES,EBAY_DE
# EBAY_QUERIES=Rolex,Omega,Seiko
# EBAY_CAMPAIGN_ID=            # eBay Partner Network (afiliado)
# USE_MOCK=1                   # mezcla los datos de prueba con los reales
# DEBUG_PARSE=1                # muestra por qué se descarta cada título

# --- Despliegue en Netlify (solo para el job de scraping / GitHub Actions; NO los pongas en .env.local) ---
# NETLIFY_SITE_ID=             # Site configuration > Site ID
# NETLIFY_AUTH_TOKEN=          # User settings > Applications > Personal access tokens
